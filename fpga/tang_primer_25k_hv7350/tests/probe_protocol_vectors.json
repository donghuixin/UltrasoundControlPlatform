{
  "schema_version": 1,
  "protocol": "HV7350 four-probe UART, 115200 8N1",
  "assumptions": [
    "Each vector is independent; establish its initial state before sending the request.",
    "No concurrent S2 event or natural session expiry occurs while the request is processed.",
    "Frames are raw binary bytes, not ASCII hex text, with no CR/LF appended.",
    "Sequence IDs are echoed, not deduplicated. Duplicate START restarts the session.",
    "Golden state transitions model command behavior; full-cycle RTL tests are separate."
  ],
  "vectors": [
    {
      "id": "power_on_status",
      "setup": "Power-on idle; no session has run.",
      "initial": {"active": 0, "next": 1, "completed": false},
      "command": 19, "argument": 0, "sequence": 0,
      "request_hex": "A5 5A 13 00 00 13",
      "response_hex": "5A A5 13 00 00 00 01 00 12",
      "result": 0,
      "expected": {"active": 0, "next": 1, "completed": false},
      "session_effect": "none"
    },
    {
      "id": "start_hv1",
      "setup": "Start HV1 from power-on idle.",
      "initial": {"active": 0, "next": 1, "completed": false},
      "command": 16, "argument": 1, "sequence": 1,
      "request_hex": "A5 5A 10 01 01 10",
      "response_hex": "5A A5 10 01 00 01 02 01 13",
      "result": 0,
      "expected": {"active": 1, "next": 2, "completed": false},
      "session_effect": "restart"
    },
    {
      "id": "start_hv2",
      "setup": "Interrupt HV1 with an explicit START HV2.",
      "initial": {"active": 1, "next": 2, "completed": false},
      "command": 16, "argument": 2, "sequence": 2,
      "request_hex": "A5 5A 10 02 02 10",
      "response_hex": "5A A5 10 02 00 02 03 01 12",
      "result": 0,
      "expected": {"active": 2, "next": 3, "completed": false},
      "session_effect": "restart"
    },
    {
      "id": "start_hv3",
      "setup": "Interrupt HV2 with an explicit START HV3.",
      "initial": {"active": 2, "next": 3, "completed": false},
      "command": 16, "argument": 3, "sequence": 3,
      "request_hex": "A5 5A 10 03 03 10",
      "response_hex": "5A A5 10 03 00 03 04 01 15",
      "result": 0,
      "expected": {"active": 3, "next": 4, "completed": false},
      "session_effect": "restart"
    },
    {
      "id": "start_hv4",
      "setup": "Interrupt HV3 with an explicit START HV4; NEXT wraps to HV1.",
      "initial": {"active": 3, "next": 4, "completed": false},
      "command": 16, "argument": 4, "sequence": 4,
      "request_hex": "A5 5A 10 04 04 10",
      "response_hex": "5A A5 10 04 00 04 01 01 10",
      "result": 0,
      "expected": {"active": 4, "next": 1, "completed": false},
      "session_effect": "restart"
    },
    {
      "id": "next_wrap_hv1",
      "setup": "NEXT while HV4 is running starts HV1, not idle.",
      "initial": {"active": 4, "next": 1, "completed": false},
      "command": 17, "argument": 0, "sequence": 5,
      "request_hex": "A5 5A 11 00 05 14",
      "response_hex": "5A A5 11 05 00 01 02 01 16",
      "result": 0,
      "expected": {"active": 1, "next": 2, "completed": false},
      "session_effect": "restart"
    },
    {
      "id": "stop_keep_next",
      "setup": "STOP HV1. The cursor remains HV2 and completed is cleared.",
      "initial": {"active": 1, "next": 2, "completed": false},
      "command": 18, "argument": 0, "sequence": 6,
      "request_hex": "A5 5A 12 00 06 14",
      "response_hex": "5A A5 12 06 00 00 02 00 16",
      "result": 0,
      "expected": {"active": 0, "next": 2, "completed": false},
      "session_effect": "stop"
    },
    {
      "id": "completed_status",
      "setup": "HV3 previously ran for its complete five seconds; no new START or STOP followed.",
      "initial": {"active": 0, "next": 4, "completed": true},
      "command": 19, "argument": 0, "sequence": 7,
      "request_hex": "A5 5A 13 00 07 14",
      "response_hex": "5A A5 13 07 00 00 04 02 12",
      "result": 0,
      "expected": {"active": 0, "next": 4, "completed": true},
      "session_effect": "none"
    },
    {
      "id": "unknown_command",
      "setup": "HV2 is running; unknown command FE has a valid checksum.",
      "initial": {"active": 2, "next": 3, "completed": false},
      "command": 254, "argument": 0, "sequence": 8,
      "request_hex": "A5 5A FE 00 08 F6",
      "response_hex": "5A A5 FE 08 01 02 03 01 F7",
      "result": 1,
      "expected": {"active": 2, "next": 3, "completed": false},
      "session_effect": "none"
    },
    {
      "id": "invalid_start_arg",
      "setup": "HV2 is running; START argument zero is not a probe number.",
      "initial": {"active": 2, "next": 3, "completed": false},
      "command": 16, "argument": 0, "sequence": 9,
      "request_hex": "A5 5A 10 00 09 19",
      "response_hex": "5A A5 10 09 02 02 03 01 1B",
      "result": 2,
      "expected": {"active": 2, "next": 3, "completed": false},
      "session_effect": "none"
    },
    {
      "id": "invalid_next_arg",
      "setup": "HV3 previously completed; NEXT requires argument zero, so argument one is rejected.",
      "initial": {"active": 0, "next": 4, "completed": true},
      "command": 17, "argument": 1, "sequence": 10,
      "request_hex": "A5 5A 11 01 0A 1A",
      "response_hex": "5A A5 11 0A 02 00 04 02 1F",
      "result": 2,
      "expected": {"active": 0, "next": 4, "completed": true},
      "session_effect": "none"
    },
    {
      "id": "duplicate_start_seq",
      "setup": "HV2 is still running after start_hv2; replay that exact request and sequence. Timer restarts from zero.",
      "initial": {"active": 2, "next": 3, "completed": false},
      "command": 16, "argument": 2, "sequence": 2,
      "request_hex": "A5 5A 10 02 02 10",
      "response_hex": "5A A5 10 02 00 02 03 01 12",
      "result": 0,
      "expected": {"active": 2, "next": 3, "completed": false},
      "session_effect": "restart"
    }
  ]
}
